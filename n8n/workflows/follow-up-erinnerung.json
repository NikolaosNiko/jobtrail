			"name": "Einzeln aufteilen"
		},
		{
			"parameters": {
				"jsCode": "const lines = [];\n\nfor (const item of $input.all()) {\n\tconst application = item.json;\n\tconst date_parts = application.applied_at.split('-');\n\tconst days = Math.floor((Date.now() - Date.parse(application.applied_at)) / 86400000);\n\n\tlines.push(\n\t\t'• ' + application.company + ' – ' + application.position + '\\n'\n\t\t+ '   beworben am ' + date_parts[2] + '.' + date_parts[1] + '.' + date_parts[0] + ' (vor ' + days + ' Tagen)\\n'\n\t\t+ '   ' + application.edit_url\n\t);\n}\n\nconst title = lines.length == 1\n\t? '🔔 Bei dieser Bewerbung solltest du nachhaken:'\n\t: '🔔 Bei diesen ' + lines.length + ' Bewerbungen solltest du nachhaken:';\n\nreturn [\n\t{\n\t\tjson: {\n\t\t\ttext: title + '\\n\\n' + lines.join('\\n\\n'),\n\t\t},\n\t},\n];\n"
			},
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				660,
				0
			],
			"id": "0b6f1c1e-2b02-4c1e-9a01-000000000004",
			"name": "Nachricht formulieren"
		},
